{
  "name": "swiftfix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "seed:services": "node --env-file=.env.local scripts/seed-services.mjs",
    "seed:pricing": "node --env-file=.env.local scripts/seed-pricing.mjs",
    "seed:partners": "node --env-file=.env.local scripts/seed-partners.mjs",
    "seed:site": "node --env-file=.env.local scripts/seed-site-settings.mjs",
    "seed:all": "npm run seed:site && npm run seed:pricing && npm run seed:partners && npm run seed:services",
    "seed:service-images": "node --env-file=.env.local scripts/seed-service-images.mjs",
    "import:service-content": "node --env-file=.env.local scripts/import-service-content.mjs",
    "generate:service-patches": "node scripts/generate-service-patches.mjs",
    "migrate:service-path-segments": "node --env-file=.env.local scripts/migrate-service-path-segments.mjs",
    "seed:service-categories": "node --env-file=.env.local scripts/seed-service-categories.mjs",
    "seed:grouped-services": "node --env-file=.env.local scripts/seed-grouped-services.mjs",
    "seed:full": "npm run seed:service-categories && npm run seed:grouped-services"
  },
  "dependencies": {
    "@portabletext/react": "^6.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sanity/client": "^7.20.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.21.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "next-intl": "^4.8.3",
    "next-sanity": "^12.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.9.4",
    "sanity": "^5.21.0",
    "styled-components": "^6.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
